# Copy to .env for local use. NEVER commit a real .env or a real secret.
# Values below are placeholders / local defaults, not credentials.

# Full Postgres URL (overrides config/database.yml when set).
# Example local form: postgres://localhost/placementpulse_development
DATABASE_URL=

# Redis URL used by Sidekiq.
REDIS_URL=redis://localhost:6379/0

# SMTP for real email delivery (development uses file delivery to tmp/mails
# when SMTP_ADDRESS is unset; test uses the :test delivery method).
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_DOMAIN=
MAILER_FROM=PlacementPulse <no-reply@placementpulse.local>

# Browser origin allowed by CORS (the frontend dev server).
FRONTEND_ORIGIN=http://localhost:5173

# Rails master key (note only): generate with `bin/rails credentials:edit`
# and keep the real key out of the repository.
RAILS_MASTER_KEY=
